# Configuracion NO sensible del ambiente dev.
# Se carga con dotenv desde el handler (src/config/loadEnv.js).
#
# IMPORTANTE: aqui no van credenciales ni tokens. Las credenciales de iAxis se
# resuelven en Secrets Manager (IAXIS_SECRET_NAME, definido en serverless.yml a
# partir de environments/dev.yml).

# --- Base de datos iAxis ---------------------------------------------------
# Solo se usa si el secreto no trae connectString.
DB_CONNECT_STRING = ""
DB_POOL_MIN = "0"
DB_POOL_MAX = "4"
DB_POOL_TIMEOUT = "60"
DB_CALL_TIMEOUT_MS = "30000"

# --- Servicios SOAP externos ------------------------------------------------
# TODO: completar con los endpoints del ambiente dev.
URL_MEDIATION_INSPECCION = ""
URL_AUTO_SISA = ""
SOAP_TIMEOUT = "10000"

# --- Comportamiento ---------------------------------------------------------
LOG_LEVEL = "info"
# 'auto' responde en el mismo protocolo de la peticion; 'rest' y 'soap' lo fuerzan.
RESPONSE_PROTOCOL = "auto"

# --- Auditoria (axis.audit_services_web) ------------------------------------
AUDIT_ENABLED = "true"
# 'true' guarda el request/response sin enmascarar. Se deja en false por
# minimizacion de datos personales (GDPR) y alcance de datos sensibles (SOC2).
AUDIT_STORE_RAW = "false"
AUDIT_MAX_PAYLOAD_CHARS = "30000"

# --- Compatibilidad con el legacy -------------------------------------------
# 'true' reproduce el sobre SOAP no estandar del servicio Java.
SOAP_LEGACY_ENVELOPE_NS = "false"
# 'true' reproduce los defectos del legacy en polizas de cumplimiento.
LEGACY_BUG_COMPAT = "false"
